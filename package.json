    "@types/swagger-ui-express": "^4.1.2",
    "body-parser": "^1.19.0",
    "bunyan": "^1.8.15",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "dotenv": "^8.2.0",
    "email-validator": "^2.0.4",
    "eosjs": "^22.1.0",
    "errorhandler": "^1.5.1",
    "express": "^4.17.1",
    "faker": "^4.1.0",
    "ftp": "^0.3.10",
    "hash-files": "^1.1.1",
    "helmet": "^5.1.0",
    "ipfs-http-client": "^56.0.1",
    "json2csv": "^5.0.5",
    "jsonwebtoken": "^8.5.1",
    "jspdf": "^2.5.1",
    "mammoth": "^1.12.2",
    "mime": "^2.5.2",
    "moment": "^2.29.3",
    "mongoose": "^6.2.9",
    "morgan": "^1.10.0",
    "multer": "^1.4.2",
    "multer-sftp": "^1.1.1",
